theme = 'catppuccin_macchiato'

[editor]
idle-timeout = 800
auto-format = true
auto-save   = true
bufferline  = 'multiple'
# clipboard-provider = "termcode"
color-modes             = true
completion-replace      = true
completion-timeout      = 50
cursorline              = true
end-of-line-diagnostics = "hint"
line-number             = 'relative'
# shell = [
#   'pwsh',
#   '-Command',
# ]
true-color = true

[editor.cursor-shape]
insert = 'bar'
select = 'underline'

[editor.file-picker]
hidden = false
follow-symlinks=true
deduplicate-links=false

[editor.whitespace.render]
# space = "all"
tab = "all"

[editor.whitespace.characters]
space = "·"
tab   = "→"

[editor.indent-guides]
# character = '┆'
render = true

[editor.soft-wrap]
enable = true
# wrap-indicator = ""

[editor.inline-diagnostics]
cursor-line     = 'hint'
max-diagnostics = 10
max-wrap        = 20
prefix-len      = 1

[editor.lsp]
auto-signature-help      = false
display-inlay-hints      = true
display-messages         = true
inlay-hints-length-limit = 30

[editor.statusline]
left = [
  'mode',
  'spinner',
  'version-control',
  'file-name',
  'read-only-indicator',
  'file-modification-indicator',
]
right = [
  "file-line-ending",
  "file-encoding",
  # "spacer",
  "diagnostics",
  "selections",
  "register",
  "position",
]

[editor.gutters]
layout = [
  "spacer",
  "diagnostics",
  "line-numbers",
  "spacer",
  "diff",
]

[keys.normal]
# 'A-[' = 'goto_previous_buffer'
# 'A-]' = 'goto_next_buffer'
# 'A-w' = ':buffer-close'
# 'X' = 'extend_line_above'

[keys.select]
# 'A-[' = 'goto_previous_buffer'
# 'A-]' = 'goto_next_buffer'
# 'X' = 'extend_line_above'

[keys.insert]
