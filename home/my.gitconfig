[user]
	email = 134658521+Huliiiiii@users.noreply.github.com
	name = Huliiiiii
[rebase]
	autoStash = true
[rerere]
	enabled = true
[core]
	editor = hx
	logallrefupdates = true
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[merge]
	autoStash = true
	conflictStyle = "diff3"
[diff]
	algorithm = histogram
	external = difft
[include]
	path = ~/.config/delta/catppuccin.gitconfig
[delta]
	features = catppuccin-mocha
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
