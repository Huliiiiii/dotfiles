# Set to false because gtk memory leak
gtk-single-instance = true
cursor-style = bar
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
window-show-tab-bar = auto
window-theme = dark
# window-decoration = server
font-family="Cascadia Next SC"
font-size=14
# font-variation=wght=450
keybind = ctrl+n=new_window

keybind = alt+w>h=new_split:left
keybind = alt+w>j=new_split:down
keybind = alt+w>k=new_split:up
keybind = alt+w>l=new_split:right
keybind = alt+w>f=toggle_split_zoom
keybind = performable:alt+h=goto_split:left
keybind = performable:alt+j=goto_split:bottom
keybind = performable:alt+k=goto_split:top
keybind = performable:alt+l=goto_split:right


keybind = alt+]=next_tab
keybind = alt+[=previous_tab
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9

keybind = ctrl+enter=unbind
# keybind = ctrl+n=unbind


window-save-state = always
